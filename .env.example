# --- Banco de dados (Neon Postgres free tier) ---
# Crie um projeto em https://neon.tech (sem cartao de credito).
# Use a "pooled connection string" para DATABASE_URL (pgbouncer) e a
# "direct connection string" para DIRECT_URL (usada só pelas migrations).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/bosquecoins?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/bosquecoins?sslmode=require"

# --- NextAuth ---
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-valor-aleatorio"
NEXTAUTH_URL="http://localhost:3000"

# --- Google OAuth ---
# Google Cloud Console > APIs & Services > Credentials > OAuth Client ID (Web application)
# Tipo de app: "Interna" dentro do Google Workspace do colegio (secao 7 da especificacao)
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID="xxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxxxx"

# Dominio institucional aceito no login (RN-10)
ALLOWED_EMAIL_DOMAIN="bosquemananciais.org.br"

# --- Login de desenvolvimento (NUNCA em producao) ---
# So tem efeito quando NODE_ENV !== 'production' *e* DEV_AUTH_ENABLED=true.
# Habilita um provider extra ("Entrar como... (dev)") que loga como qualquer
# usuario ja cadastrado na tabela `usuarios`, sem depender do Google OAuth.
# Deixe comentado/false em qualquer ambiente que se pareca com producao.
DEV_AUTH_ENABLED="false"
